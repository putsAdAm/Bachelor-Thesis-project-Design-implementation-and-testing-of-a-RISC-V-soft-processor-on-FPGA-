library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use work.memTypes.all;

entity t0 is
end entity;

architecture Behavioral of t0 is

    component CPU
        port (
            clk      : in  std_logic;
            RMemOut  : out reg_array;
            outSign  : out std_logic_vector(31 downto 0)
        );
    end component;

    signal clk       : std_logic := '0';
    signal RMemOut   : reg_array:= (others => (others => '0'));
    signal outSign  : std_logic_vector(31 downto 0) := (others => '0');
    
begin

    -- Impulsi di clock
    clk_process : process
    begin
        while true loop
            clk <= '0';
            wait for 5 ns;
            clk <= '1';
            wait for 5 ns;
        end loop;
    end process;

    -- Istanziamento Device Under Test
    DUT: CPU
        port map (
            clk      => clk,
            RMemOut  => RMemOut,
            outSign => outSign
        );

    -- Processo di stimolazione
    stim_proc : process
    begin
	-- Lascia il tempo di eseguire il programma
        wait for 500 ns;
	-- Verifica scrittura in memoria
        assert to_integer(unsigned(outSign)) = 25
        report "Errore: DMemOut(25) non contiene 25" severity error;
        report "Test completato" severity note;
        wait;
    end process;
end;
